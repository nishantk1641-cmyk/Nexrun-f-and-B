rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Document
    match /users/{userId} {
      // Users can only read their own profile
      allow read: if isOwner(userId);

      // Users can create their initial profile or update allowed fields (not plan elevation)
      allow create: if isOwner(userId) 
                    && request.resource.data.email is string
                    && request.resource.data.plan in ['free'];

      allow update: if isOwner(userId) 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscriptionStatus']));

      // Projects subcollection under user: users/{uid}/projects/{projectId}
      match /projects/{projectId} {
        // Only the owner can read, write, or delete their projects
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
